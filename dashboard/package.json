{
  "name": "zenchron-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh ./dev.sh",
    "build": "mkdir -p dist && cp index.html dist/index.html && cp -R public/. dist/ && esbuild src/main.tsx --bundle --splitting --format=esm --minify --sourcemap --outdir=dist --loader:.css=css --external:/sidebar-wave.png",
    "typecheck": "tsc --noEmit",
    "test:e2e:agent-runtime": "node e2e/agent-runtime-process.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@mantine/charts": "^9.7.4",
    "@mantine/core": "^9.7.4",
    "@mantine/form": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.90.2",
    "@xyflow/react": "^12.12.0",
    "ag-grid-react": "^36.3.0",
    "elkjs": "^0.12.1",
    "monaco-editor": "0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.0.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
